# Copy to .env for local development (cp .env.example .env). Never commit .env.
# On Render, set these in the dashboard instead.

# Local development: a SQLite file in this folder. Production: Neon's *pooled* connection string,
#   postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# "gemini" calls Google's Gemini API; "fake" makes predictable cards with no key (for trying the app).
LLM_PROVIDER=gemini
# From https://aistudio.google.com/apikey (free tier).
GEMINI_API_KEY=
# One model, or several separated by commas (best first). Each has its own free quota: when one
# is rate limited, requests move on to the next and skip it for a while.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite-preview,gemma-4-26b-a4b-it,gemma-4-31b-it

# AI cards a day: per phone that Google Play vouches for, and per install for everything else
# (older apps, the website, iPhones for now, emulators). See app/integrity.py. While
# PLAY_INTEGRITY_CREDENTIALS is empty, every install gets DAILY_CARD_QUOTA, as before.
DAILY_CARD_QUOTA=50
UNVERIFIED_DAILY_CARD_QUOTA=50
# Google Play Integrity: the service account's JSON key, pasted as one line. Empty = off.
PLAY_INTEGRITY_CREDENTIALS=
MAX_INPUT_CHARS=15000
# Per network address, so one machine can't invent device ids to get more cards.
IP_DAILY_CARD_QUOTA=200
IP_REQUESTS_PER_MINUTE=30

# API docs at /docs: ENABLE_DOCS=true opens them (local only). On Render, ADMIN_TOKEN unlocks them
# instead: the browser asks for a login, user "admin", password = the token.
ENABLE_DOCS=false
ADMIN_TOKEN=
